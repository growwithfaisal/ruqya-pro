[{"n":1,"ar":" ٱلْقَارِعَةُ","tr":"AlqariAAa","en":"The Striking Calamity -"},{"n":2,"ar":"مَا ٱلْقَارِعَةُ","tg":[[4,5,0]],"tr":"Ma alqariAAa","en":"What is the Striking Calamity?"},{"n":3,"ar":"وَمَآ أَدْرَىٰكَ مَا ٱلْقَارِعَةُ","tg":[[2,6,6],[9,11,7],[13,15,3],[22,23,0]],"tr":"Wama adraka ma alqariAAa","en":"And what can make you know what is the Striking Calamity?"},{"n":4,"ar":"يَوْمَ يَكُونُ ٱلنَّاسُ كَٱلْفَرَاشِ ٱلْمَبْثُوثِ","tg":[[15,16,0],[16,17,2],[17,20,14],[26,27,0],[37,38,0],[42,44,7],[44,47,4]],"tr":"Yawma yakoonu annasu kalfarashialmabthooth","en":"It is the Day when people will be like moths, dispersed,"},{"n":5,"ar":"وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ٱلْمَنفُوشِ","tg":[[10,11,0],[23,24,0],[33,34,0],[38,41,9]],"tr":"Watakoonu aljibalu kalAAihnialmanfoosh","en":"And the mountains will be like wool, fluffed up."},{"n":6,"ar":"فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ","tg":[[4,7,14],[11,15,9],[24,27,3]],"tr":"Faamma man thaqulat mawazeenuh","en":"Then as for one whose scales are heavy [with good deeds],"},{"n":7,"ar":"فَهُوَ فِى عِيشَةٍ رَّاضِيَةٍ","tg":[[16,22,13]],"tr":"Fahuwa fee AAeeshatin radiya","en":"He will be in a pleasant life."},{"n":8,"ar":"وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ","tg":[[4,7,14],[24,27,3]],"tr":"Waamma man khaffat mawazeenuh","en":"But as for one whose scales are light,"},{"n":9,"ar":"فَأُمُّهُۥ هَاوِيَةٌ","tg":[[4,7,14],[7,10,3]],"tr":"Faommuhu hawiya","en":"His refuge will be an abyss."},{"n":10,"ar":"وَمَآ أَدْرَىٰكَ مَا هِيَهْ","tg":[[2,6,6],[9,11,7],[13,15,3]],"tr":"Wama adraka ma hiya","en":"And what can make you know what that is?"},{"n":11,"ar":"نَارٌ حَامِيَةٌۢ","tr":"Narun hamiya","en":"It is a Fire, intensely hot."}]