[{"n":1,"ar":" سَبِّحِ ٱسْمَ رَبِّكَ ٱلْأَعْلَى","tg":[[9,10,0],[23,24,0]],"tr":"Sabbihi isma rabbika al-aAAla","en":"Exalt the name of your Lord, the Most High,"},{"n":2,"ar":"ٱلَّذِى خَلَقَ فَسَوَّىٰ","tr":"Allathee khalaqa fasawwa","en":"Who created and proportioned"},{"n":3,"ar":"وَٱلَّذِى قَدَّرَ فَهَدَىٰ","tg":[[2,3,0]],"tr":"Wallathee qaddara fahada","en":"And who destined and [then] guided"},{"n":4,"ar":"وَٱلَّذِىٓ أَخْرَجَ ٱلْمَرْعَىٰ","tg":[[2,3,0],[6,10,6],[20,21,0]],"tr":"Wallathee akhraja almarAAa","en":"And who brings out the pasture"},{"n":5,"ar":"فَجَعَلَهُۥ غُثَآءً أَحْوَىٰ","tg":[[8,11,3],[14,18,6]],"tr":"FajaAAalahu ghuthaan ahwa","en":"And [then] makes it black stubble."},{"n":6,"ar":"سَنُقْرِئُكَ فَلَا تَنسَىٰٓ","tg":[[4,6,7],[21,24,9]],"tr":"Sanuqri-oka fala tansa","en":"We will make you recite, [O Muḥammad], and you will not forget,"},{"n":7,"ar":"إِلَّا مَا شَآءَ ٱللَّهُ ۚ إِنَّهُۥ يَعْلَمُ ٱلْجَهْرَ وَمَا يَخْفَىٰ","tg":[[11,15,6],[18,19,0],[30,33,14],[33,36,3],[46,47,0]],"tr":"Illa ma shaa Allahuinnahu yaAAlamu aljahra wama yakhfa","en":"Except what Allāh should will. Indeed, He knows what is declared and what is hidden."},{"n":8,"ar":"وَنُيَسِّرُكَ لِلْيُسْرَىٰ","tr":"Wanuyassiruka lilyusra","en":"And We will ease you toward ease."},{"n":9,"ar":"فَذَكِّرْ إِن نَّفَعَتِ ٱلذِّكْرَىٰ","tg":[[10,17,12],[24,25,0],[25,26,2]],"tr":"Fathakkir in nafaAAati aththikra","en":"So remind, if the reminder should benefit;"},{"n":10,"ar":"سَيَذَّكَّرُ مَن يَخْشَىٰ","tg":[[13,19,12]],"tr":"Sayaththakkaru man yakhsha","en":"He who fears [Allāh] will be reminded."},{"n":11,"ar":"وَيَتَجَنَّبُهَا ٱلْأَشْقَى","tg":[[8,11,14],[17,18,0]],"tr":"Wayatajannabuha al-ashqa","en":"But the wretched one will avoid it"},{"n":12,"ar":"ٱلَّذِى يَصْلَى ٱلنَّارَ ٱلْكُبْرَىٰ","tg":[[16,17,0],[17,18,2],[18,21,14],[25,26,0],[30,32,7]],"tr":"Allathee yasla annaraalkubra","en":"[He] who will [enter and] burn in the greatest Fire,"},{"n":13,"ar":"ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰ","tg":[[2,5,14]],"tr":"Thumma la yamootu feeha walayahya","en":"Neither dying therein nor living."},{"n":14,"ar":"قَدْ أَفْلَحَ مَن تَزَكَّىٰ","tg":[[2,4,7],[16,20,9]],"tr":"Qad aflaha man tazakka","en":"He has certainly succeeded who purifies himself"},{"n":15,"ar":"وَذَكَرَ ٱسْمَ رَبِّهِۦ فَصَلَّىٰ","tg":[[9,10,0],[20,23,3]],"tr":"Wathakara isma rabbihi fasalla","en":"And mentions the name of his Lord and prays."},{"n":16,"ar":"بَلْ تُؤْثِرُونَ ٱلْحَيَوٰةَ ٱلدُّنْيَا","tg":[[17,18,0],[24,26,1],[29,30,0],[30,31,2]],"tr":"Bal tu/thiroona alhayata addunya","en":"But you prefer the worldly life,"},{"n":17,"ar":"وَٱلْـَٔاخِرَةُ خَيْرٌ وَأَبْقَىٰٓ","tg":[[2,3,0],[20,25,12],[27,29,7]],"tr":"Wal-akhiratu khayrun waabqa","en":"While the Hereafter is better and more enduring."},{"n":18,"ar":"إِنَّ هَـٰذَا لَفِى ٱلصُّحُفِ ٱلْأُولَىٰ","tg":[[2,5,14],[6,10,3],[20,21,0],[21,22,2],[30,31,0]],"tr":"Inna hatha lafee assuhufial-oola","en":"Indeed, this is in the former scriptures,"},{"n":19,"ar":"صُحُفِ إِبْرَٰهِيمَ وَمُوسَىٰ","tg":[[9,11,7],[11,14,3]],"tr":"Suhufi ibraheema wamoosa","en":"The scriptures of Abraham and Moses."}]