[{"n":1,"ar":" عَبَسَ وَتَوَلَّىٰٓ","tr":"AAabasa watawalla","en":"He [i.e., the Prophet (ﷺ) ] frowned and turned away"},{"n":2,"ar":"أَن جَآءَهُ ٱلْأَعْمَىٰ","tg":[[2,6,9],[13,14,0]],"tr":"An jaahu alaAAma","en":"Because there came to him the blind man, [interrupting]."},{"n":3,"ar":"وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ","tg":[[8,10,7],[23,26,3]],"tr":"Wama yudreeka laAAallahu yazzakka","en":"But what would make you perceive, [O Muḥammad], that perhaps he might be purified"},{"n":4,"ar":"أَوْ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكْرَىٰٓ","tg":[[20,23,9],[28,29,0],[29,30,2]],"tr":"Aw yaththakkaru fatanfaAAahu alththikra","en":"Or be reminded and the remembrance would benefit him?"},{"n":5,"ar":"أَمَّا مَنِ ٱسْتَغْنَىٰ","tg":[[2,5,14],[12,13,0]],"tr":"Amma mani istaghna","en":"As for he who thinks himself without need,"},{"n":6,"ar":"فَأَنتَ لَهُۥ تَصَدَّىٰ","tg":[[4,7,9],[10,13,3]],"tr":"Faanta lahu tasadda","en":"To him you give attention."},{"n":7,"ar":"وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ","tr":"Wama AAalayka alla yazzakka","en":"And not upon you [is any blame] if he will not be purified."},{"n":8,"ar":"وَأَمَّا مَن جَآءَكَ يَسْعَىٰ","tg":[[4,7,14],[11,15,9]],"tr":"Waamma man jaaka yasAAa","en":"But as for he who came to you striving [for knowledge]"},{"n":9,"ar":"وَهُوَ يَخْشَىٰ","tr":"Wahuwa yakhsha","en":"While he fears [Allāh],"},{"n":10,"ar":"فَأَنتَ عَنْهُ تَلَهَّىٰ","tg":[[4,7,9]],"tr":"Faanta AAanhu talahha","en":"From him you are distracted."},{"n":11,"ar":"كَلَّآ إِنَّهَا تَذْكِرَةٌ","tg":[[2,7,6],[10,13,14]],"tr":"Kalla innaha tathkiratun","en":"No! Indeed, they [i.e., these verses] are a reminder;"},{"n":12,"ar":"فَمَن شَآءَ ذَكَرَهُۥ","tg":[[4,8,9]],"tr":"Faman shaa thakarahu","en":"So whoever wills may remember it."},{"n":13,"ar":"فِى صُحُفٍ مُّكَرَّمَةٍ","tg":[[8,14,12]],"tr":"Fee suhufin mukarramatin","en":"[It is recorded] in honored sheets,"},{"n":14,"ar":"مَّرْفُوعَةٍ مُّطَهَّرَةٍۭ","tg":[[10,16,12]],"tr":"MarfooAAatin mutahharatin","en":"Exalted and purified,"},{"n":15,"ar":"بِأَيْدِى سَفَرَةٍ","tr":"Biaydee safaratin","en":"[Carried] by the hands of messenger-angels,"},{"n":16,"ar":"كِرَامٍۭ بَرَرَةٍ","tg":[[5,11,11]],"tr":"Kiramin bararatin","en":"Noble and dutiful."},{"n":17,"ar":"قُتِلَ ٱلْإِنسَـٰنُ مَآ أَكْفَرَهُۥ","tg":[[7,8,0],[12,17,9],[20,24,6]],"tr":"Qutila alinsanu ma akfarahu","en":"Destroyed [i.e., cursed] is man; how disbelieving is he."},{"n":18,"ar":"مِنْ أَىِّ شَىْءٍ خَلَقَهُۥ","tr":"Min ayyi shayin khalaqahu","en":"From what thing [i.e., substance] did He create him?"},{"n":19,"ar":"مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ","tg":[[0,7,12],[7,9,7],[20,23,3]],"tr":"Min nutfatin khalaqahu faqaddarahu","en":"From a sperm-drop He created him and destined for him;"},{"n":20,"ar":"ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ","tg":[[2,5,14],[6,7,0],[7,8,2]],"tr":"Thumma alssabeela yassarahu","en":"Then He eased the way for him;"},{"n":21,"ar":"ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥ","tg":[[2,5,14],[13,16,3],[21,23,7]],"tr":"Thumma amatahu faaqbarahu","en":"Then He causes his death and provides a grave for him."},{"n":22,"ar":"ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ","tg":[[2,5,14],[12,16,6],[21,24,9]],"tr":"Thumma itha shaa ansharahu","en":"Then when He wills, He will resurrect him."},{"n":23,"ar":"كَلَّا لَمَّا يَقْضِ مَآ أَمَرَهُۥ","tg":[[9,12,14],[16,18,7],[21,25,6]],"tr":"Kalla lamma yaqdi ma amarahu","en":"No! He [i.e., man] has not yet accomplished what He commanded him."},{"n":24,"ar":"فَلْيَنظُرِ ٱلْإِنسَـٰنُ إِلَىٰ طَعَامِهِۦٓ","tg":[[6,9,9],[12,13,0],[17,22,9]],"tr":"Falyanthuri alinsanu ila taAAamihi","en":"Then let mankind look at his food -"},{"n":25,"ar":"أَنَّا صَبَبْنَا ٱلْمَآءَ صَبًّا","tg":[[2,5,14],[11,13,7],[17,18,0],[20,24,6]],"tr":"Anna sababna almaa sabban","en":"How We poured down water in torrents,"},{"n":26,"ar":"ثُمَّ شَقَقْنَا ٱلْأَرْضَ شَقًّا","tg":[[2,5,14],[10,12,7],[16,17,0]],"tr":"Thumma shaqaqna alarda shaqqan","en":"Then We broke open the earth, splitting [it with sprouts],"},{"n":27,"ar":"فَأَنۢبَتْنَا فِيهَا حَبًّا","tg":[[4,8,11]],"tr":"Faanbatna feeha habban","en":"And caused to grow within it grain"},{"n":28,"ar":"وَعِنَبًا وَقَضْبًا","tg":[[6,12,12]],"tr":"WaAAinaban waqadban","en":"And grapes and herbage"},{"n":29,"ar":"وَزَيْتُونًا وَنَخْلًا","tg":[[9,15,12]],"tr":"Wazaytoonan wanakhlan","en":"And olive and palm trees"},{"n":30,"ar":"وَحَدَآئِقَ غُلْبًا","tg":[[4,8,6]],"tr":"Wahadaiqa ghulban","en":"And gardens of dense shrubbery"},{"n":31,"ar":"وَفَـٰكِهَةً وَأَبًّا","tg":[[2,6,3],[10,15,12]],"tr":"Wafakihatan waabban","en":"And fruit and grass -"},{"n":32,"ar":"مَّتَـٰعًا لَّكُمْ وَلِأَنْعَـٰمِكُمْ","tg":[[3,7,3],[7,14,13],[27,31,3]],"tr":"MataAAan lakum walianAAamikum","en":"[As] enjoyment [i.e., provision] for you and your grazing livestock."},{"n":33,"ar":"فَإِذَا جَآءَتِ ٱلصَّآخَّةُ","tg":[[8,12,6],[17,18,0],[18,19,2],[19,24,5]],"tr":"Faitha jaati alssakhkhatu","en":"But when there comes the Deafening Blast"},{"n":34,"ar":"يَوْمَ يَفِرُّ ٱلْمَرْءُ مِنْ أَخِيهِ","tg":[[15,16,0],[32,35,4]],"tr":"Yawma yafirru almaro min akheehi","en":"On the Day a man will flee from his brother"},{"n":35,"ar":"وَأُمِّهِۦ وَأَبِيهِ","tg":[[4,7,14],[7,10,3],[15,18,4]],"tr":"Waommihi waabeehi","en":"And his mother and his father"},{"n":36,"ar":"وَصَـٰحِبَتِهِۦ وَبَنِيهِ","tg":[[2,6,3],[12,15,3],[20,23,4]],"tr":"Wasahibatihi wabaneehi","en":"And his wife and his children,"},{"n":37,"ar":"لِكُلِّ ٱمْرِئٍ مِّنْهُمْ يَوْمَئِذٍ شَأْنٌ يُغْنِيهِ","tg":[[8,9,0],[13,19,12],[34,39,9],[41,46,12],[48,51,4]],"tr":"Likulli imriin minhum yawmaithin shanun yughneehi","en":"For every man, that Day, will be a matter adequate for him."},{"n":38,"ar":"وُجُوهٌ يَوْمَئِذٍ مُّسْفِرَةٌ","tg":[[5,10,12],[16,22,12]],"tr":"Wujoohun yawmaithin musfiratun","en":"[Some] faces, that Day, will be bright -"},{"n":39,"ar":"ضَاحِكَةٌ مُّسْتَبْشِرَةٌ","tg":[[7,13,12],[17,19,7]],"tr":"Dahikatun mustabshiratun","en":"Laughing, rejoicing at good news."},{"n":40,"ar":"وَوُجُوهٌ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٌ","tg":[[7,12,12]],"tr":"Wawujoohun yawmaithin AAalayha ghabaratun","en":"And [other] faces, that Day, will have upon them dust."},{"n":41,"ar":"تَرْهَقُهَا قَتَرَةٌ","tr":"Tarhaquha qataratun","en":"Blackness will cover them."},{"n":42,"ar":"أُو۟لَـٰٓئِكَ هُمُ ٱلْكَفَرَةُ ٱلْفَجَرَةُ","tg":[[2,4,1],[4,9,6],[19,20,0],[31,32,0]],"tr":"Olaika humu alkafaratu alfajaratu","en":"Those are the disbelievers, the wicked ones."}]