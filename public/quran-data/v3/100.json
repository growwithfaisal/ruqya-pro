[{"n":1,"ar":" وَٱلْعَـٰدِيَـٰتِ ضَبْحًا","tg":[[3,4,0],[6,10,3],[12,16,3],[21,23,7]],"tr":"WaalAAadiyati dabhan","en":"By the racers, panting,"},{"n":2,"ar":"فَٱلْمُورِيَـٰتِ قَدْحًا","tg":[[2,3,0],[10,14,3],[19,21,7]],"tr":"Faalmooriyati qadhan","en":"And the producers of sparks [when] striking"},{"n":3,"ar":"فَٱلْمُغِيرَٰتِ صُبْحًا","tg":[[2,3,0],[10,13,3],[18,20,7]],"tr":"Faalmugheerati subhan","en":"And the chargers at dawn,"},{"n":4,"ar":"فَأَثَرْنَ بِهِۦ نَقْعًا","tg":[[13,16,3],[19,21,7]],"tr":"Faatharna bihi naqAAan","en":"Stirring up thereby [clouds of] dust,"},{"n":5,"ar":"فَوَسَطْنَ بِهِۦ جَمْعًا","tg":[[6,8,7],[13,16,3]],"tr":"Fawasatna bihi jamAAan","en":"Arriving thereby in the center collectively,"},{"n":6,"ar":"إِنَّ ٱلْإِنسَـٰنَ لِرَبِّهِۦ لَكَنُودٌ","tg":[[2,5,14],[6,7,0],[11,16,9],[26,29,3],[34,37,4],[37,39,7]],"tr":"Inna alinsana lirabbihi lakanoodun","en":"Indeed mankind, to his Lord, is ungrateful."},{"n":7,"ar":"وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٌ","tg":[[4,7,14],[7,10,3],[18,21,3],[30,33,4],[33,35,7]],"tr":"Wainnahu AAala thalika lashaheedun","en":"And indeed, he is to that a witness."},{"n":8,"ar":"وَإِنَّهُۥ لِحُبِّ ٱلْخَيْرِ لَشَدِيدٌ","tg":[[4,7,14],[7,10,3],[19,20,0],[33,36,4],[36,38,7]],"tr":"Wainnahu lihubbi alkhayri lashadeedun","en":"And indeed he is, in love of wealth, intense."},{"n":9,"ar":"۞ أَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِى ٱلْقُبُورِ","tg":[[42,43,0],[47,50,4]],"tr":"Afala yaAAlamu itha buAAthira ma fee alquboori","en":"But does he not know that when the contents of the graves are scattered"},{"n":10,"ar":"وَحُصِّلَ مَا فِى ٱلصُّدُورِ","tg":[[18,19,0],[19,20,2],[23,26,4]],"tr":"Wahussila ma fee alssudoori","en":"And that within the breasts is obtained,"},{"n":11,"ar":"إِنَّ رَبَّهُم بِهِمْ يَوْمَئِذٍ لَّخَبِيرٌۢ","tg":[[2,5,14],[11,17,8],[30,36,13],[38,41,4]],"tr":"Inna rabbahum bihim yawmaithin lakhabeerun","en":"Indeed, their Lord with them, that Day, is [fully] Aware."}]