[{"n":1,"ar":" وَيْلٌ لِّكُلِّ هُمَزَةٍ لُّمَزَةٍ","tg":[[5,11,13],[23,29,13]],"tr":"Waylun likulli humazatin lumazatin","en":"Woe to every scorner and mocker"},{"n":2,"ar":"ٱلَّذِى جَمَعَ مَالًا وَعَدَّدَهُۥ","tg":[[20,24,12]],"tr":"Allathee jamaAAa malan waAAaddadahu","tu":[[4,6]],"en":"Who collects wealth and [continuously] counts it."},{"n":3,"ar":"يَحْسَبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ","tg":[[11,14,14],[20,24,6]],"tr":"Yahsabu anna malahu akhladahu","tu":[[2,3]],"en":"He thinks that his wealth will make him immortal."},{"n":4,"ar":"كَلَّا ۖ لَيُنۢبَذَنَّ فِى ٱلْحُطَمَةِ","tg":[[13,17,11],[19,22,14],[27,28,0]],"tr":"Kalla layunbathanna fee alhutamati","tu":[[13,15]],"en":"No! He will surely be thrown into the Crusher."},{"n":5,"ar":"وَمَآ أَدْرَىٰكَ مَا ٱلْحُطَمَةُ","tg":[[2,6,6],[9,11,7],[13,15,3],[22,23,0]],"tr":"Wama adraka ma alhutamatu","en":"And what can make you know what is the Crusher?"},{"n":6,"ar":"نَارُ ٱللَّهِ ٱلْمُوقَدَةُ","tg":[[6,7,0],[14,15,0]],"tr":"Naru Allahi almooqadatu","en":"It is the fire of Allāh, [eternally] fueled,"},{"n":7,"ar":"ٱلَّتِى تَطَّلِعُ عَلَى ٱلْأَفْـِٔدَةِ","tg":[[24,25,0]],"tr":"Allatee tattaliAAu AAala alafidati","tu":[[10,12]],"en":"Which mounts directed at the hearts."},{"n":8,"ar":"إِنَّهَا عَلَيْهِم مُّؤْصَدَةٌ","tg":[[2,5,14],[15,22,10]],"tr":"lnnaha AAalayhim musadatun","tu":[[19,20]],"en":"Indeed, it [i.e., Hellfire] will be closed down upon them"},{"n":9,"ar":"فِى عَمَدٍ مُّمَدَّدَةٍۭ","tg":[[8,14,12]],"tr":"Fee AAamadin mumaddadatin","en":"In extended columns."}]