[{"n":1,"ar":" أَلْهَىٰكُمُ ٱلتَّكَاثُرُ","tr":"Alhakumu alttakathuru","en":"Competition in [worldly] increase diverts you"},{"n":2,"ar":"حَتَّىٰ زُرْتُمُ ٱلْمَقَابِرَ","tg":[[17,18,0]],"tr":"Hatta zurtumu almaqabira","tu":[[0,1]],"en":"Until you visit the graveyards."},{"n":3,"ar":"كَلَّا سَوْفَ تَعْلَمُونَ","tg":[[20,23,4]],"tr":"Kalla sawfa taAAlamoona","en":"No! You are going to know."},{"n":4,"ar":"ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَ","tg":[[2,5,14],[26,29,4]],"tr":"Thumma kalla sawfa taAAlamoona","en":"Then, no! You are going to know."},{"n":5,"ar":"كَلَّا لَوْ تَعْلَمُونَ عِلْمَ ٱلْيَقِينِ","tg":[[31,32,0],[36,39,4]],"tr":"Kalla law taAAlamoona AAilma alyaqeeni","en":"No! If you only knew with knowledge of certainty..."},{"n":6,"ar":"لَتَرَوُنَّ ٱلْجَحِيمَ","tg":[[8,11,14],[12,13,0],[17,20,4]],"tr":"Latarawunna aljaheema","tu":[[16,17]],"en":"You will surely see the Hellfire."},{"n":7,"ar":"ثُمَّ لَتَرَوُنَّهَا عَيْنَ ٱلْيَقِينِ","tg":[[2,5,14],[14,17,14],[28,29,0],[33,36,4]],"tr":"Thumma latarawunnaha AAayna alyaqeeni","en":"Then you will surely see it with the eye of certainty."},{"n":8,"ar":"ثُمَّ لَتُسْـَٔلُنَّ يَوْمَئِذٍ عَنِ ٱلنَّعِيمِ","tg":[[2,5,14],[17,20,14],[37,38,0],[38,39,2],[39,42,14],[42,45,4]],"tr":"Thumma latusalunna yawmaithin AAani alnnaAAeemi","tu":[[25,27]],"en":"Then you will surely be asked that Day about pleasure."}]