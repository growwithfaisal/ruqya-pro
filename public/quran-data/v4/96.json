[{"n":1,"ar":" ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ","tg":[[2,4,7],[11,12,0],[25,26,0],[37,39,7]],"tr":"Iqra biismi rabbika allathee khalaqa","tu":[[24,28]],"en":"Recite in the name of your Lord who created"},{"n":2,"ar":"خَلَقَ ٱلْإِنسَـٰنَ مِنْ عَلَقٍ","tg":[[7,8,0],[12,17,9],[29,31,7]],"tr":"Khalaqa alinsana min AAalaqin","tu":[[13,14]],"en":"Created man from a clinging substance."},{"n":3,"ar":"ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ","tg":[[1,3,7],[18,19,0]],"tr":"Iqra warabbuka alakramu","en":"Recite, and your Lord is the most Generous -"},{"n":4,"ar":"ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ","tg":[[18,19,0]],"tr":"Allathee AAallama bialqalami","tu":[[4,8]],"en":"Who taught by the pen"},{"n":5,"ar":"عَلَّمَ ٱلْإِنسَـٰنَ مَا لَمْ يَعْلَمْ","tg":[[8,9,0],[13,18,9]],"tr":"AAallama alinsana ma lam yaAAlam","tu":[[14,15],[19,20]],"en":"Taught man that which he knew not."},{"n":6,"ar":"كَلَّآ إِنَّ ٱلْإِنسَـٰنَ لَيَطْغَىٰٓ","tg":[[2,7,6],[10,13,14],[14,15,0],[19,24,9],[31,33,7]],"tr":"Kalla inna alinsana layatgha","tu":[[4,5],[16,17],[24,25],[27,28]],"en":"No! [But] indeed, man transgresses"},{"n":7,"ar":"أَن رَّءَاهُ ٱسْتَغْنَىٰٓ","tg":[[0,7,13],[13,14,0]],"tr":"An raahu istaghna","tu":[[5,6]],"en":"Because he sees himself self-sufficient."},{"n":8,"ar":"إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجْعَىٰٓ","tg":[[2,5,14],[21,22,0],[22,23,2],[26,28,7]],"tr":"Inna ila rabbika alrrujAAa","tu":[[7,8],[25,26]],"en":"Indeed, to your Lord is the return."},{"n":9,"ar":"أَرَءَيْتَ ٱلَّذِى يَنْهَىٰ","tg":[[11,12,0]],"tr":"Araayta allathee yanha","tu":[[12,16],[21,22]],"en":"Have you seen the one who forbids"},{"n":10,"ar":"عَبْدًا إِذَا صَلَّىٰٓ","tg":[[2,4,7]],"tr":"AAabdan itha salla","tu":[[5,6],[9,12],[13,14],[17,18]],"en":"A servant when he prays?"},{"n":11,"ar":"أَرَءَيْتَ إِن كَانَ عَلَى ٱلْهُدَىٰٓ","tg":[[13,17,9],[27,28,0]],"tr":"Araayta in kana AAala alhuda","tu":[[12,13],[20,21],[27,28]],"en":"Have you seen if he is upon guidance"},{"n":12,"ar":"أَوْ أَمَرَ بِٱلتَّقْوَىٰٓ","tg":[[14,15,0],[15,16,2],[19,21,7]],"tr":"Aw amara bialttaqwa","tu":[[18,19]],"en":"Or enjoins righteousness?"},{"n":13,"ar":"أَرَءَيْتَ إِن كَذَّبَ وَتَوَلَّىٰٓ","tg":[[13,17,9]],"tr":"Araayta in kaththaba watawalla","tu":[[13,17],[29,30]],"en":"Have you seen if he denies and turns away -"},{"n":14,"ar":"أَلَمْ يَعْلَم بِأَنَّ ٱللَّهَ يَرَىٰ","tg":[[11,17,8],[19,22,14],[23,24,0]],"tr":"Alam yaAAlam bianna Allaha yara","tu":[[23,24],[30,31]],"en":"Does he not know that Allāh sees?"},{"n":15,"ar":"كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًۢا بِٱلنَّاصِيَةِ","tg":[[9,16,13],[21,24,9],[35,42,11],[42,43,0],[43,44,2],[44,47,14]],"tr":"Kalla lain lam yantahi lanasfaAAan bialnnasiyati","tu":[[4,5],[32,33],[41,43]],"en":"No! If he does not desist, We will surely drag him by the forelock"},{"n":16,"ar":"نَاصِيَةٍ كَـٰذِبَةٍ خَاطِئَةٍ","tg":[[7,14,9]],"tr":"Nasiyatin kathibatin khatiatin","tu":[[1,3],[11,14],[23,24]],"en":"A lying, sinning forelock."},{"n":17,"ar":"فَلْيَدْعُ نَادِيَهُۥ","tg":[[6,8,7]],"tr":"FalyadAAu nadiyahu","tu":[[11,12]],"en":"Then let him call his associates;"},{"n":18,"ar":"سَنَدْعُ ٱلزَّبَانِيَةَ","tg":[[4,6,7],[9,10,0],[10,11,2]],"tr":"SanadAAu alzzabaniyata","tu":[[15,16]],"en":"We will call the angels of Hell."},{"n":19,"ar":"كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب ۩","tg":[[22,23,0],[27,29,7],[32,33,0],[33,35,7],[39,40,7]],"tr":"Kalla la tutiAAhu waosjud waiqtarib","tu":[[4,5],[7,8],[11,12]],"en":"No! Do not obey him. But prostrate and draw near [to Allāh]."}]