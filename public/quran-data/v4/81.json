[{"n":1,"ar":" إِذَا ٱلشَّمْسُ كُوِّرَتْ","tg":[[7,8,0],[8,9,2]],"tr":"Itha alshshamsu kuwwirat","tu":[[1,4]],"en":"When the sun is wrapped up [in darkness]"},{"n":2,"ar":"وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ","tg":[[8,9,0],[9,10,2],[10,13,14],[19,20,0],[20,23,9]],"tr":"Waitha alnnujoomu inkadarat","tu":[[3,6],[13,15]],"en":"And when the stars fall, dispersing,"},{"n":3,"ar":"وَإِذَا ٱلْجِبَالُ سُيِّرَتْ","tg":[[8,9,0]],"tr":"Waitha aljibalu suyyirat","tu":[[3,6],[12,13]],"en":"And when the mountains are removed"},{"n":4,"ar":"وَإِذَا ٱلْعِشَارُ عُطِّلَتْ","tg":[[8,9,0]],"tr":"Waitha alAAisharu AAuttilat","tu":[[3,6],[14,15],[21,23]],"en":"And when full-term she-camels are neglected"},{"n":5,"ar":"وَإِذَا ٱلْوُحُوشُ حُشِرَتْ","tg":[[8,9,0]],"tr":"Waitha alwuhooshu hushirat","tu":[[3,6],[11,14],[18,19]],"en":"And when the wild beasts are gathered"},{"n":6,"ar":"وَإِذَا ٱلْبِحَارُ سُجِّرَتْ","tg":[[8,9,0]],"tr":"Waitha albiharu sujjirat","tu":[[3,6],[11,13]],"en":"And when the seas are filled with flame"},{"n":7,"ar":"وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ","tg":[[8,9,0],[9,10,2],[10,13,14]],"tr":"Waitha alnnufoosu zuwwijat","tu":[[3,6],[13,15]],"en":"And when the souls are paired"},{"n":8,"ar":"وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ","tg":[[8,9,0],[15,18,3]],"tr":"Waitha almawoodatu suilat","tu":[[3,6]],"en":"And when the girl [who was] buried alive is asked"},{"n":9,"ar":"بِأَىِّ ذَنۢبٍ قُتِلَتْ","tg":[[10,14,11]],"tr":"Biayyi thanbin qutilat","tu":[[7,9]],"en":"For what sin she was killed"},{"n":10,"ar":"وَإِذَا ٱلصُّحُفُ نُشِرَتْ","tg":[[8,9,0],[9,10,2]],"tr":"Waitha alssuhufu nushirat","tu":[[3,6],[9,11],[12,13]],"en":"And when the pages are spread [i.e., made public]"},{"n":11,"ar":"وَإِذَا ٱلسَّمَآءُ كُشِطَتْ","tg":[[8,9,0],[9,10,2],[13,17,6]],"tr":"Waitha alssamao kushitat","tu":[[3,6],[21,22]],"en":"And when the sky is stripped away"},{"n":12,"ar":"وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ","tg":[[8,9,0]],"tr":"Waitha aljaheemu suAAAAirat","tu":[[3,6],[11,14]],"en":"And when Hellfire is set ablaze"},{"n":13,"ar":"وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ","tg":[[8,9,0],[13,16,14]],"tr":"Waitha aljannatu ozlifat","tu":[[3,6]],"en":"And when Paradise is brought near,"},{"n":14,"ar":"عَلِمَتْ نَفْسٌ مَّآ أَحْضَرَتْ","tg":[[13,19,12]],"tr":"AAalimat nafsun ma ahdarat","tu":[[17,18],[20,22]],"en":"A soul will [then] know what it has brought [with it]."},{"n":15,"ar":"فَلَآ أُقْسِمُ بِٱلْخُنَّسِ","tg":[[2,6,6],[9,11,7],[18,19,0],[23,26,14]],"tr":"Fala oqsimu bialkhunnasi","tu":[[3,4]],"en":"So I swear by the retreating stars -"},{"n":16,"ar":"ٱلْجَوَارِ ٱلْكُنَّسِ","tg":[[11,12,0],[16,19,14]],"tr":"Aljawari alkunnasi","tu":[[5,6]],"en":"Those that run [their courses] and disappear [i.e., set]"},{"n":17,"ar":"وَٱلَّيْلِ إِذَا عَسْعَسَ","tg":[[2,3,0]],"tr":"Waallayli itha AAasAAasa","tu":[[11,14]],"en":"And by the night as it closes in"},{"n":18,"ar":"وَٱلصُّبْحِ إِذَا تَنَفَّسَ","tg":[[2,3,0],[3,4,2],[7,9,7]],"tr":"Waalssubhi itha tanaffasa","tu":[[4,6],[8,9],[12,15]],"en":"And by the dawn when it breathes [i.e., stirs]"},{"n":19,"ar":"إِنَّهُۥ لَقَوْلُ رَسُولٍ كَرِيمٍ","tg":[[2,5,14],[5,8,3],[23,28,9],[28,31,4]],"tr":"Innahu laqawlu rasoolin kareemin","tu":[[18,20],[27,29]],"en":"[That] indeed, it [i.e., the Qur’ān] is a word [conveyed by] a noble messenger [i.e., Gabriel]"},{"n":20,"ar":"ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍ","tg":[[14,17,9],[22,23,0],[34,37,4]],"tr":"Thee quwwatin AAinda thee alAAarshi makeenin","tu":[[0,4],[21,25],[39,41]],"en":"[Who is] possessed of power and with the Owner of the Throne, secure [in position],"},{"n":21,"ar":"مُّطَاعٍ ثَمَّ أَمِينٍ","tg":[[6,11,9],[11,14,14],[17,20,4]],"tr":"MutaAAin thamma ameenin","tu":[[2,4],[18,20]],"en":"Obeyed there [in the heavens] and trustworthy."},{"n":22,"ar":"وَمَا صَاحِبُكُم بِمَجْنُونٍ","tg":[[13,19,8],[21,23,7],[23,26,4]],"tr":"Wama sahibukum bimajnoonin","tu":[[3,4],[5,8],[21,23]],"en":"And your companion [i.e., Prophet Muḥammad (ﷺ) ] is not [at all] mad."},{"n":23,"ar":"وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ","tg":[[6,8,7],[19,20,0],[29,30,0],[34,37,4]],"tr":"Walaqad raahu bialofuqi almubeeni","tu":[[10,11],[29,31]],"en":"And he has already seen him [i.e., Gabriel] in the clear horizon."},{"n":24,"ar":"وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍ","tg":[[17,18,0],[31,34,4]],"tr":"Wama huwa AAala alghaybi bidaneenin","tu":[[3,4],[14,15],[27,28],[30,32]],"en":"And he [i.e., Muḥammad (ﷺ)] is not a withholder of [knowledge of] the unseen."},{"n":25,"ar":"وَمَا هُوَ بِقَوْلِ شَيْطَـٰنٍ رَّجِيمٍ","tg":[[24,28,3],[28,34,13],[34,37,4]],"tr":"Wama huwa biqawli shaytanin rajeemin","tu":[[3,4],[22,24],[31,33]],"en":"And it [i.e., the Qur’ān] is not the word of a devil, expelled [from the heavens]."},{"n":26,"ar":"فَأَيْنَ تَذْهَبُونَ","tg":[[15,18,4]],"tr":"Faayna tathhaboona","tu":[[9,11],[14,16]],"en":"So where are you going?"},{"n":27,"ar":"إِنْ هُوَ إِلَّا ذِكْرٌ لِّلْعَـٰلَمِينَ","tg":[[21,27,13],[29,33,3],[35,38,4]],"tr":"In huwa illa thikrun lilAAalameena","tu":[[11,12],[13,15],[26,27],[30,32]],"en":"It is not except a reminder to the worlds"},{"n":28,"ar":"لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ","tg":[[4,8,9],[15,18,9],[21,27,12],[31,34,4]],"tr":"Liman shaa minkum an yastaqeema","tu":[[8,9],[27,29]],"en":"For whoever wills among you to take a right course."},{"n":29,"ar":"وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَـٰلَمِينَ","tg":[[8,12,6],[20,25,6],[26,32,12],[32,36,6],[39,40,0],[53,54,0],[56,60,3],[62,65,4]],"tr":"Wama tashaoona illa an yashaa Allahu rabbu alAAalameena","tu":[[3,4],[9,12],[18,19],[27,28],[33,34],[47,48],[51,53]],"en":"And you do not will except that Allāh wills - Lord of the worlds."}]