[{"n":1,"ar":" أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ","tg":[[12,13,0],[32,33,0],[33,34,2],[34,38,4]],"tr":"Araayta allathee yukaththibu bialddeeni","tu":[[12,14],[21,25]],"en":"Have you seen the one who denies the Recompense?"},{"n":2,"ar":"فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ","tg":[[2,5,3],[10,11,0],[26,27,0],[31,34,4]],"tr":"Fathalika allathee yaduAAAAu alyateema","tu":[[2,4],[14,16]],"en":"For that is the one who drives away the orphan"},{"n":3,"ar":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ","tg":[[29,30,0],[36,39,4]],"tr":"Wala yahuddu AAala taAAami almiskeeni","tu":[[7,8],[9,11],[19,20]],"en":"And does not encourage the feeding of the poor."},{"n":4,"ar":"فَوَيْلٌ لِّلْمُصَلِّينَ","tg":[[6,12,13],[18,22,4]],"tr":"Fawaylun lilmusalleena","tu":[[14,15]],"en":"So woe to those who pray"},{"n":5,"ar":"ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ","tg":[[17,21,9],[34,37,4]],"tr":"Allatheena hum AAan salatihim sahoona","tu":[[4,6],[20,21]],"en":"[But] who are heedless of their prayer -"},{"n":6,"ar":"ٱلَّذِينَ هُمْ يُرَآءُونَ","tg":[[17,21,6],[21,24,4]],"tr":"Allatheena hum yuraoona","tu":[[4,6]],"en":"Those who make show [of their deeds]"},{"n":7,"ar":"وَيَمْنَعُونَ ٱلْمَاعُونَ","tg":[[14,15,0],[20,23,4]],"tr":"WayamnaAAoona almaAAoona","en":"And withhold [simple] assistance."}]