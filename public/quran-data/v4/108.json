[{"n":1,"ar":" إِنَّآ أَعْطَيْنَـٰكَ ٱلْكَوْثَرَ","tg":[[3,6,14],[17,21,3],[24,25,0]],"tr":"Inna aAAtaynaka alkawthara","tu":[[8,9]],"en":"Indeed, We have granted you, [O Muḥammad], al-Kawthar."},{"n":2,"ar":"فَصَلِّ لِرَبِّكَ وَٱنْحَرْ","tg":[[20,21,0]],"tr":"Fasalli lirabbika wainhar","tu":[[2,3],[22,23]],"en":"So pray to your Lord and offer sacrifice [to Him alone]."},{"n":3,"ar":"إِنَّ شَانِئَكَ هُوَ ٱلْأَبْتَرُ","tg":[[2,5,14],[21,22,0],[26,28,7]],"tr":"Inna shaniaka huwa alabtaru","en":"Indeed, your enemy is the one cut off."}]