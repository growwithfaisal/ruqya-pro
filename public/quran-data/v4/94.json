[{"n":1,"ar":" أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ","tg":[[24,26,7]],"tr":"Alam nashrah laka sadraka","tu":[[11,12],[18,19]],"en":"Did We not expand for you, [O Muḥammad], your breast?"},{"n":2,"ar":"وَوَضَعْنَا عَنكَ وِزْرَكَ","tg":[[14,17,9]],"tr":"WawadaAAna AAanka wizraka","tu":[[4,5]],"en":"And We removed from you your burden"},{"n":3,"ar":"ٱلَّذِىٓ أَنقَضَ ظَهْرَكَ","tg":[[4,8,6],[11,14,9]],"tr":"Allathee anqada thahraka","tu":[[4,6],[13,14],[16,18]],"en":"Which had weighed upon your back"},{"n":4,"ar":"وَرَفَعْنَا لَكَ ذِكْرَكَ","tr":"WarafaAAna laka thikraka","tu":[[16,18]],"en":"And raised high for you your repute."},{"n":5,"ar":"فَإِنَّ مَعَ ٱلْعُسْرِ يُسْرًا","tg":[[4,7,14],[13,14,0]],"tr":"Fainna maAAa alAAusri yusran","en":"For indeed, with hardship [will be] ease [i.e., relief]."},{"n":6,"ar":"إِنَّ مَعَ ٱلْعُسْرِ يُسْرًا","tg":[[2,5,14],[11,12,0]],"tr":"Inna maAAa alAAusri yusran","en":"Indeed, with hardship [will be] ease."},{"n":7,"ar":"فَإِذَا فَرَغْتَ فَٱنصَبْ","tg":[[19,20,0],[20,23,9],[23,25,7]],"tr":"Faitha faraghta fainsab","tu":[[3,5],[20,21]],"en":"So when you have finished [your duties], then stand up [for worship]."},{"n":8,"ar":"وَإِلَىٰ رَبِّكَ فَٱرْغَب","tg":[[19,20,0],[24,25,7]],"tr":"Waila rabbika fairghab","en":"And to your Lord direct [your] longing."}]