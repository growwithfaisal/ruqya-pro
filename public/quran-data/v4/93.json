[{"n":1,"ar":" وَٱلضُّحَىٰ","tg":[[3,4,0],[4,5,2]],"tr":"Waaldduha","tu":[[4,6],[7,8]],"en":"By the morning brightness"},{"n":2,"ar":"وَٱلَّيْلِ إِذَا سَجَىٰ","tg":[[2,3,0]],"tr":"Waallayli itha saja","tu":[[11,13]],"en":"And [by] the night when it covers with darkness,"},{"n":3,"ar":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ","tr":"Ma waddaAAaka rabbuka wama qala","en":"Your Lord has not taken leave of you, [O Muḥammad], nor has He detested [you]."},{"n":4,"ar":"وَلَلْـَٔاخِرَةُ خَيْرٌ لَّكَ مِنَ ٱلْأُولَىٰ","tg":[[21,27,13],[35,36,0]],"tr":"Walalakhiratu khayrun laka mina aloola","en":"And the Hereafter is better for you than the first [life]."},{"n":5,"ar":"وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰٓ","tr":"Walasawfa yuAAteeka rabbuka fatarda","tu":[[14,15],[33,34]],"en":"And your Lord is going to give you, and you will be satisfied."},{"n":6,"ar":"أَلَمْ يَجِدْكَ يَتِيمًا فَـَٔاوَىٰ","tg":[[11,13,7],[21,30,9]],"tr":"Alam yajidka yateeman faawa","en":"Did He not find you an orphan and give [you] refuge?"},{"n":7,"ar":"وَوَجَدَكَ ضَآلًّا فَهَدَىٰ","tg":[[18,22,9]],"tr":"Wawajadaka dallan fahada","tu":[[11,12]],"en":"And He found you lost and guided [you],"},{"n":8,"ar":"وَوَجَدَكَ عَآئِلًا فَأَغْنَىٰ","tg":[[11,15,6],[19,23,9]],"tr":"Wawajadaka AAailan faaghna","en":"And He found you poor and made [you] self-sufficient."},{"n":9,"ar":"فَأَمَّا ٱلْيَتِيمَ فَلَا تَقْهَرْ","tg":[[4,7,14],[9,10,0],[28,30,7]],"tr":"Faamma alyateema fala taqhar","en":"So as for the orphan, do not oppress [him]."},{"n":10,"ar":"وَأَمَّا ٱلسَّآئِلَ فَلَا تَنْهَرْ","tg":[[4,7,14],[9,10,0],[10,11,2],[11,16,6]],"tr":"Waamma alssaila fala tanhar","en":"And as for the petitioner, do not repel [him]."},{"n":11,"ar":"وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ","tg":[[4,7,14]],"tr":"Waamma biniAAmati rabbika fahaddith","tu":[[28,29]],"en":"But as for the favor of your Lord, report [it]."}]