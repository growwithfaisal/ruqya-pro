[{"n":1,"ar":" قُلْ هُوَ ٱللَّهُ أَحَدٌ","tg":[[11,12,0],[23,25,7]],"tr":"Qul huwa Allahu ahadun","tu":[[17,18]],"en":"Say, \"He is Allāh, [who is] One,"},{"n":2,"ar":"ٱللَّهُ ٱلصَّمَدُ","tg":[[8,9,0],[9,10,2],[15,17,7]],"tr":"Allahu alssamadu","tu":[[9,11]],"en":"Allāh, the Eternal Refuge."},{"n":3,"ar":"لَمْ يَلِدْ وَلَمْ يُولَدْ","tg":[[9,11,7],[24,26,7]],"tr":"Lam yalid walam yooladu","en":"He neither begets nor is born,"},{"n":4,"ar":"وَلَمْ يَكُن لَّهُۥ كُفُوًا أَحَدٌۢ","tg":[[9,16,13],[16,19,3],[32,35,7]],"tr":"Walam yakun lahu kufuwan ahadun","tu":[[26,27]],"en":"Nor is there to Him any equivalent.\""}]