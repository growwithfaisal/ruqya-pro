[{"n":1,"ar":" وَٱلسَّمَآءِ وَٱلطَّارِقِ","tg":[[3,4,0],[4,5,2],[8,12,6],[17,18,0],[18,19,2],[25,27,7]],"tr":"Waalssamai waalttariqi","tu":[[8,9],[15,18]],"ts":[[2,3],[3,4],[13,14],[14,15]],"en":"By the sky and the night comer"},{"n":2,"ar":"وَمَآ أَدْرَىٰكَ مَا ٱلطَّارِقُ","tg":[[2,6,6],[9,11,7],[13,15,3],[22,23,0],[23,24,2],[30,32,7]],"tr":"Wama adraka ma alttariqu","tu":[[3,4],[8,9],[13,14],[17,20]],"ts":[[15,16],[16,17]],"en":"And what can make you know what is the night comer?"},{"n":3,"ar":"ٱلنَّجْمُ ٱلثَّاقِبُ","tg":[[1,2,2],[2,5,14],[5,7,7],[10,11,0],[11,12,2],[18,20,7]],"tr":"Alnnajmu alththaqibu","tu":[[15,16]],"ts":[[1,2],[9,10],[10,11]],"en":"It is the piercing star"},{"n":4,"ar":"إِن كُلُّ نَفْسٍ لَّمَّا عَلَيْهَا حَافِظٌ","tg":[[2,6,9],[14,20,13],[20,23,14]],"tr":"In kullu nafsin lamma AAalayha hafithun","tu":[[20,21],[29,30],[31,33],[35,37]],"en":"There is no soul but that it has over it a protector."},{"n":5,"ar":"فَلْيَنظُرِ ٱلْإِنسَـٰنُ مِمَّ خُلِقَ","tg":[[6,9,9],[12,13,0],[17,22,9],[27,30,14],[35,37,7]],"tr":"Falyanthuri alinsanu mimma khuliqa","tu":[[6,8],[17,18]],"ts":[[12,13]],"en":"So let man observe from what he was created."},{"n":6,"ar":"خُلِقَ مِن مَّآءٍ دَافِقٍ","tg":[[7,14,12],[16,21,9],[24,26,7]],"tr":"Khuliqa min main dafiqin","tu":[[13,14],[18,19]],"en":"He was created from a fluid, ejected,"},{"n":7,"ar":"يَخْرُجُ مِنۢ بَيْنِ ٱلصُّلْبِ وَٱلتَّرَآئِبِ","tg":[[9,16,11],[21,22,0],[22,23,2],[33,34,0],[34,35,2],[38,42,6],[44,46,7]],"tr":"Yakhruju min bayni alssulbi waalttaraibi","tu":[[21,23],[36,37]],"ts":[[19,20],[20,21],[30,31],[31,32]],"en":"Emerging from between the backbone and the ribs."},{"n":8,"ar":"إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرٌ","tg":[[2,5,14],[5,8,3],[18,20,7],[22,25,3]],"tr":"Innahu AAala rajAAihi laqadirun","tu":[[11,12],[25,26]],"en":"Indeed, He [i.e., Allāh], to return him [to life], is Able."},{"n":9,"ar":"يَوْمَ تُبْلَى ٱلسَّرَآئِرُ","tg":[[9,11,7],[15,16,0],[16,17,2],[20,24,6]],"tr":"Yawma tubla alssarairu","tu":[[10,11],[18,19]],"ts":[[12,13],[13,14]],"en":"The Day when secrets will be put on trial,"},{"n":10,"ar":"فَمَا لَهُۥ مِن قُوَّةٍ وَلَا نَاصِرٍ","tg":[[8,11,3],[14,18,9],[21,26,12]],"tr":"Fama lahu min quwwatin wala nasirin","tu":[[3,4],[26,27],[29,31]],"en":"Then he [i.e., man] will have no power or any helper."},{"n":11,"ar":"وَٱلسَّمَآءِ ذَاتِ ٱلرَّجْعِ","tg":[[2,3,0],[3,4,2],[7,11,6],[20,21,0],[21,22,2],[25,27,7]],"tr":"Waalssamai thati alrrajAAi","tu":[[8,9],[11,14]],"ts":[[2,3],[3,4],[17,18],[18,19]],"en":"By the sky which sends back"},{"n":12,"ar":"وَٱلْأَرْضِ ذَاتِ ٱلصَّدْعِ","tg":[[2,3,0],[18,19,0],[19,20,2],[23,25,7]],"tr":"Waalardi thati alssadAAi","tu":[[6,7],[9,12],[17,19]],"ts":[[2,3],[15,16],[16,17]],"en":"And [by] the earth which splits,"},{"n":13,"ar":"إِنَّهُۥ لَقَوْلٌ فَصْلٌ","tg":[[2,5,14],[5,8,3],[15,20,9]],"tr":"Innahu laqawlun faslun","tu":[[18,19]],"en":"Indeed, it [i.e., the Qur’ān] is a decisive statement,"},{"n":14,"ar":"وَمَا هُوَ بِٱلْهَزْلِ","tg":[[13,14,0]],"tr":"Wama huwa bialhazli","tu":[[3,4]],"ts":[[12,13]],"en":"And it is not amusement."},{"n":15,"ar":"إِنَّهُمْ يَكِيدُونَ كَيْدًا","tg":[[2,5,14]],"tr":"Innahum yakeedoona kaydan","tu":[[11,13],[14,16],[23,24]],"en":"Indeed, they are planning a plan,"},{"n":16,"ar":"وَأَكِيدُ كَيْدًا","tr":"Waakeedu kaydan","tu":[[4,6],[13,14]],"en":"But I am planning a plan."},{"n":17,"ar":"فَمَهِّلِ ٱلْكَـٰفِرِينَ أَمْهِلْهُمْ رُوَيْدًۢا","tg":[[10,11,0],[13,17,3]],"tr":"Famahhili alkafireena amhilhum ruwaydan","tu":[[13,14],[17,19],[37,38]],"ts":[[10,11]],"en":"So allow time for the disbelievers. Leave them awhile."}]