[{"n":1,"ar":" قُلْ يَـٰٓأَيُّهَا ٱلْكَـٰفِرُونَ","tg":[[6,11,6],[20,21,0],[23,27,3],[29,32,4]],"tr":"Qul ya ayyuha alkafiroona","en":"Say, \"O disbelievers,"},{"n":2,"ar":"لَآ أَعْبُدُ مَا تَعْبُدُونَ","tg":[[0,4,6],[24,27,4]],"tr":"La aAAbudu ma taAAbudoona","tu":[[1,2],[12,13],[21,23]],"en":"I do not worship what you worship."},{"n":3,"ar":"وَلَآ أَنتُمْ عَـٰبِدُونَ مَآ أَعْبُدُ","tg":[[2,6,6],[9,12,9],[15,19,3],[27,31,6],[38,40,7]],"tr":"Wala antum AAabidoona ma aAAbudu","tu":[[3,4],[13,14],[17,19],[23,24]],"en":"Nor are you worshippers of what I worship."},{"n":4,"ar":"وَلَآ أَنَا۠ عَابِدٌ مَّا عَبَدتُّمْ","tr":"Wala ana AAabidun ma AAabadtum","tu":[[3,4],[7,8],[11,12],[19,20]],"en":"Nor will I be a worshipper of what you worship."},{"n":5,"ar":"وَلَآ أَنتُمْ عَـٰبِدُونَ مَآ أَعْبُدُ","tg":[[2,6,6],[9,12,9],[15,19,3],[27,31,6],[38,40,7]],"tr":"Wala antum AAabidoona ma aAAbudu","tu":[[3,4],[13,14],[17,19],[23,24]],"en":"Nor will you be worshippers of what I worship."},{"n":6,"ar":"لَكُمْ دِينُكُمْ وَلِىَ دِينِ","tg":[[24,27,4]],"tr":"Lakum deenukum waliya deeni","tu":[[7,9],[23,25]],"en":"For you is your religion, and for me is my religion.\""}]