[{"n":1,"ar":" هَلْ أَتَىٰكَ حَدِيثُ ٱلْغَـٰشِيَةِ","tr":"Hal ataka hadeethu alghashiyati","tu":[[6,7],[10,11],[13,15],[23,24]],"ts":[[19,20]],"en":"Has there reached you the report of the Overwhelming [event]?"},{"n":2,"ar":"وُجُوهٌ يَوْمَئِذٍ خَـٰشِعَةٌ","tg":[[5,10,12],[19,23,3]],"tr":"Wujoohun yawmaithin khashiAAatun","tu":[[3,5],[15,17],[22,23]],"en":"[Some] faces, that Day, will be humbled,"},{"n":3,"ar":"عَامِلَةٌ نَّاصِبَةٌ","tg":[[7,13,12]],"tr":"AAamilatun nasibatun","tu":[[2,3],[12,14]],"en":"Working [hard] and exhausted."},{"n":4,"ar":"تَصْلَىٰ نَارًا حَامِيَةً","tr":"Tasla naran hamiyatan","tu":[[2,3],[4,5],[7,8],[9,10],[13,14]],"en":"They will [enter to] burn in an intensely hot Fire."},{"n":5,"ar":"تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٍ","tr":"Tusqa min AAaynin aniyatin","tu":[[4,5],[18,19]],"en":"They will be given drink from a boiling spring."},{"n":6,"ar":"لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِن ضَرِيعٍ","tg":[[32,36,9],[36,39,4]],"tr":"Laysa lahum taAAamun illa min dareeAAin","tu":[[12,13],[16,17],[24,25],[30,31],[33,35]],"en":"For them there will be no food except from a poisonous, thorny plant"},{"n":7,"ar":"لَّا يُسْمِنُ وَلَا يُغْنِى مِن جُوعٍ","tg":[[30,34,9]],"tr":"La yusminu wala yughnee min jooAAin","tu":[[1,2],[14,15],[21,23],[29,31]],"en":"Which neither nourishes nor avails against hunger."},{"n":8,"ar":"وُجُوهٌ يَوْمَئِذٍ نَّاعِمَةٌ","tg":[[5,10,12],[16,22,12]],"tr":"Wujoohun yawmaithin naAAimatun","tu":[[3,5],[15,17],[21,22]],"en":"[Other] faces, that Day, will show pleasure."},{"n":9,"ar":"لِّسَعْيِهَا رَاضِيَةٌ","tr":"LisaAAyiha radiyatun","tu":[[9,10],[12,14]],"en":"With their effort [they are] satisfied"},{"n":10,"ar":"فِى جَنَّةٍ عَالِيَةٍ","tg":[[6,9,14]],"tr":"Fee jannatin AAaliyatin","tu":[[1,3],[15,16]],"en":"In an elevated garden,"},{"n":11,"ar":"لَّا تَسْمَعُ فِيهَا لَـٰغِيَةً","tg":[[21,25,3]],"tr":"La tasmaAAu feeha laghiyatan","tu":[[1,2],[13,15],[16,17],[19,20]],"en":"Wherein they will hear no unsuitable speech."},{"n":12,"ar":"فِيهَا عَيْنٌ جَارِيَةٌ","tg":[[11,16,9]],"tr":"Feeha AAaynun jariyatun","tu":[[1,3],[4,5],[15,16]],"en":"Within it is a flowing spring."},{"n":13,"ar":"فِيهَا سُرُرٌ مَّرْفُوعَةٌ","tg":[[11,17,12]],"tr":"Feeha sururun marfooAAatun","tu":[[1,3],[4,5],[18,20]],"en":"Within it are couches raised high"},{"n":14,"ar":"وَأَكْوَابٌ مَّوْضُوعَةٌ","tg":[[9,15,12]],"tr":"Waakwabun mawdooAAatun","tu":[[5,6],[13,16]],"en":"And cups put in place"},{"n":15,"ar":"وَنَمَارِقُ مَصْفُوفَةٌ","tr":"Wanamariqu masfoofatun","tu":[[5,6],[13,14],[15,17]],"en":"And cushions lined up"},{"n":16,"ar":"وَزَرَابِىُّ مَبْثُوثَةٌ","tg":[[15,17,7]],"tr":"Wazarabiyyu mabthoothatun","tu":[[5,6],[17,19]],"en":"And carpets spread around."},{"n":17,"ar":"أَفَلَا يَنظُرُونَ إِلَى ٱلْإِبِلِ كَيْفَ خُلِقَتْ","tg":[[10,13,9],[25,26,0]],"tr":"Afala yanthuroona ila alibili kayfa khuliqat","tu":[[4,5],[9,11],[13,15],[20,21]],"ts":[[22,23]],"en":"Then do they not look at the camels - how they are created?"},{"n":18,"ar":"وَإِلَى ٱلسَّمَآءِ كَيْفَ رُفِعَتْ","tg":[[8,9,0],[9,10,2],[13,17,6]],"tr":"Waila alssamai kayfa rufiAAat","tu":[[4,5],[12,13]],"ts":[[6,7],[7,8]],"en":"And at the sky - how it is raised?"},{"n":19,"ar":"وَإِلَى ٱلْجِبَالِ كَيْفَ نُصِبَتْ","tg":[[8,9,0]],"tr":"Waila aljibali kayfa nusibat","tu":[[4,5],[11,12],[23,24]],"ts":[[6,7]],"en":"And at the mountains - how they are erected?"},{"n":20,"ar":"وَإِلَى ٱلْأَرْضِ كَيْفَ سُطِحَتْ","tg":[[8,9,0]],"tr":"Waila alardi kayfa sutihat","tu":[[4,5],[10,11],[21,22],[23,24]],"ts":[[6,7]],"en":"And at the earth - how it is spread out?"},{"n":21,"ar":"فَذَكِّرْ إِنَّمَآ أَنتَ مُذَكِّرٌ","tg":[[12,15,14],[15,19,6],[22,25,9]],"tr":"Fathakkir innama anta muthakkirun","tu":[[2,4],[15,16],[24,26]],"en":"So remind, [O Muḥammad]; you are only a reminder."},{"n":22,"ar":"لَّسْتَ عَلَيْهِم بِمُصَيْطِرٍ","tg":[[14,20,8]],"tr":"Lasta AAalayhim bimusaytirin","tu":[[20,21],[23,24]],"en":"You are not over them a controller."},{"n":23,"ar":"إِلَّا مَن تَوَلَّىٰ وَكَفَرَ","tg":[[9,13,9]],"tr":"Illa man tawalla wakafara","tu":[[3,4],[15,16]],"en":"However, he who turns away and disbelieves"},{"n":24,"ar":"فَيُعَذِّبُهُ ٱللَّهُ ٱلْعَذَابَ ٱلْأَكْبَرَ","tg":[[14,15,0],[22,23,0],[33,34,0]],"tr":"FayuAAaththibuhu Allahu alAAathaba alakbara","tu":[[7,11],[20,21],[29,32]],"ts":[[17,18],[24,25],[35,36]],"en":"Then Allāh will punish him with the greatest punishment."},{"n":25,"ar":"إِنَّ إِلَيْنَآ إِيَابَهُمْ","tg":[[2,5,14],[12,16,6]],"tr":"Inna ilayna iyabahum","tu":[[10,11],[14,15]],"en":"Indeed, to Us is their return."},{"n":26,"ar":"ثُمَّ إِنَّ عَلَيْنَا حِسَابَهُم","tg":[[2,5,14],[8,11,14]],"tr":"Thumma inna AAalayna hisabahum","tu":[[19,20],[21,22],[24,25]],"en":"Then indeed, upon Us is their account."}]