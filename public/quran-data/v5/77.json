[{"n":1,"ar":" وَٱلْمُرْسَلَـٰتِ عُرْفًا","tg":[[3,4,0],[12,16,3]],"tr":"Waalmursalati AAurfan","tu":[[10,11],[19,20]],"ts":[[2,3]],"en":"By those [winds] sent forth in gusts"},{"n":2,"ar":"فَٱلْعَـٰصِفَـٰتِ عَصْفًا","tg":[[2,3,0],[5,9,3],[11,15,3]],"tr":"FaalAAasifati AAasfan","tu":[[6,8],[10,11],[17,18],[19,20]],"ts":[[2,3]],"en":"And the winds that blow violently"},{"n":3,"ar":"وَٱلنَّـٰشِرَٰتِ نَشْرًا","tg":[[2,3,0],[3,4,2],[4,9,14],[11,14,3]],"tr":"Waalnnashirati nashran","tu":[[6,7],[11,12],[20,21]],"ts":[[2,3],[3,4]],"en":"And [by] the winds that spread [clouds]"},{"n":4,"ar":"فَٱلْفَـٰرِقَـٰتِ فَرْقًا","tg":[[2,3,0],[5,9,3],[11,15,3]],"tr":"Faalfariqati farqan","tu":[[5,6],[9,10],[17,18]],"ts":[[2,3]],"en":"And those [angels] who bring criterion"},{"n":5,"ar":"فَٱلْمُلْقِيَـٰتِ ذِكْرًا","tg":[[2,3,0],[11,15,3]],"tr":"Faalmulqiyati thikran","tu":[[10,11],[14,16],[19,20]],"ts":[[2,3]],"en":"And those [angels] who deliver a message."},{"n":6,"ar":"عُذْرًا أَوْ نُذْرًا","tr":"AAuthran aw nuthran","tu":[[3,5],[6,7],[14,16],[17,18]],"en":"As justification or warning,"},{"n":7,"ar":"إِنَّمَا تُوعَدُونَ لَوَٰقِعٌ","tg":[[2,5,14],[22,25,3]],"tr":"Innama tooAAadoona lawaqiAAun","tu":[[5,6],[8,10],[14,16],[22,23]],"en":"Indeed, what you are promised is to occur."},{"n":8,"ar":"فَإِذَا ٱلنُّجُومُ طُمِسَتْ","tg":[[8,9,0],[9,10,2],[10,13,14]],"tr":"Faitha alnnujoomu tumisat","tu":[[3,6],[13,15],[18,19]],"ts":[[7,8],[8,9]],"en":"So when the stars are obliterated"},{"n":9,"ar":"وَإِذَا ٱلسَّمَآءُ فُرِجَتْ","tg":[[8,9,0],[9,10,2],[13,17,6]],"tr":"Waitha alssamao furijat","tu":[[3,6]],"ts":[[8,9]],"en":"And when the heaven is opened"},{"n":10,"ar":"وَإِذَا ٱلْجِبَالُ نُسِفَتْ","tg":[[8,9,0]],"tr":"Waitha aljibalu nusifat","tu":[[3,6],[12,13]],"ts":[[7,8]],"en":"And when the mountains are blown away"},{"n":11,"ar":"وَإِذَا ٱلرُّسُلُ أُقِّتَتْ","tg":[[8,9,0],[9,10,2]],"tr":"Waitha alrrusulu oqqitat","tu":[[3,6]],"ts":[[7,8],[8,9]],"en":"And when the messengers' time has come..."},{"n":12,"ar":"لِأَىِّ يَوْمٍ أُجِّلَتْ","tr":"Liayyi yawmin ojjilat","en":"For what Day was it postponed?"},{"n":13,"ar":"لِيَوْمِ ٱلْفَصْلِ","tg":[[9,10,0]],"tr":"Liyawmi alfasli","tu":[[12,13]],"ts":[[8,9]],"en":"For the Day of Judgement."},{"n":14,"ar":"وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلْفَصْلِ","tg":[[2,6,6],[9,11,7],[13,15,3],[29,30,0]],"tr":"Wama adraka ma yawmu alfasli","tu":[[3,4],[8,9],[13,14],[25,26]],"ts":[[21,22]],"en":"And what can make you know what is the Day of Judgement?"},{"n":15,"ar":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","tg":[[4,9,12],[15,21,13],[30,33,4]],"tr":"Waylun yawmaithin lilmukaththibeena","tu":[[13,15],[25,29],[31,33]],"en":"Woe, that Day, to the deniers."},{"n":16,"ar":"أَلَمْ نُهْلِكِ ٱلْأَوَّلِينَ","tg":[[16,17,0],[24,27,4]],"tr":"Alam nuhliki alawwaleena","tu":[[20,22]],"ts":[[13,14]],"en":"Did We not destroy the former peoples?"},{"n":17,"ar":"ثُمَّ نُتْبِعُهُمُ ٱلْـَٔاخِرِينَ","tg":[[2,5,14],[19,20,0],[28,31,4]],"tr":"Thumma nutbiAAuhumu alakhireena","tu":[[22,23],[27,29]],"ts":[[20,21]],"en":"Then We will follow them with the later ones."},{"n":18,"ar":"كَذَٰلِكَ نَفْعَلُ بِٱلْمُجْرِمِينَ","tg":[[2,5,3],[21,22,0],[26,28,7],[30,33,4]],"tr":"Kathalika nafAAalu bialmujrimeena","tu":[[2,5],[29,31]],"ts":[[21,22]],"en":"Thus do We deal with the criminals."},{"n":19,"ar":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","tg":[[4,9,12],[15,21,13],[30,33,4]],"tr":"Waylun yawmaithin lilmukaththibeena","tu":[[13,15],[25,29],[31,33]],"en":"Woe, that Day, to the deniers."},{"n":20,"ar":"أَلَمْ نَخْلُقكُّم مِّن مَّآءٍ مَّهِينٍ","tr":"Alam nakhluqkum min main maheenin","tu":[[21,22],[28,30]],"en":"Did We not create you from a liquid disdained?"},{"n":21,"ar":"فَجَعَلْنَـٰهُ فِى قَرَارٍ مَّكِينٍ","tg":[[8,12,3],[24,30,12],[30,33,4]],"tr":"FajaAAalnahu fee qararin makeenin","tu":[[9,10],[14,16],[20,21],[28,30]],"en":"And We placed it in a firm lodging [i.e., the womb]"},{"n":22,"ar":"إِلَىٰ قَدَرٍ مَّعْلُومٍ","tg":[[11,17,12],[19,22,4]],"tr":"Ila qadarin maAAloomin","tu":[[2,3],[17,19]],"en":"For a known extent."},{"n":23,"ar":"فَقَدَرْنَا فَنِعْمَ ٱلْقَـٰدِرُونَ","tg":[[21,22,0],[24,28,3],[30,33,4]],"tr":"Faqadarna faniAAma alqadiroona","tu":[[8,9],[22,23],[26,28]],"ts":[[19,20]],"en":"And We determined [it], and excellent [are We] to determine."},{"n":24,"ar":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","tg":[[4,9,12],[15,21,13],[30,33,4]],"tr":"Waylun yawmaithin lilmukaththibeena","tu":[[13,15],[25,29],[31,33]],"en":"Woe, that Day, to the deniers."},{"n":25,"ar":"أَلَمْ نَجْعَلِ ٱلْأَرْضَ كِفَاتًا","tg":[[9,11,7],[16,17,0]],"tr":"Alam najAAali alarda kifatan","tu":[[18,19],[24,25],[26,27]],"ts":[[14,15]],"en":"Have We not made the earth a container"},{"n":26,"ar":"أَحْيَآءً وَأَمْوَٰتًا","tg":[[4,8,6],[8,13,12],[17,20,3]],"tr":"Ahyaan waamwatan","tu":[[1,2],[3,4],[12,13],[14,15]],"en":"Of the living and the dead?"},{"n":27,"ar":"وَجَعَلْنَا فِيهَا رَوَٰسِىَ شَـٰمِخَـٰتٍ وَأَسْقَيْنَـٰكُم مَّآءً فُرَاتًا","tg":[[21,24,3],[29,33,3],[35,39,3],[39,44,12],[52,56,3],[56,63,10],[65,70,9]],"tr":"WajaAAalna feeha rawasiya shamikhatin waasqaynakum maan furatan","tu":[[9,10],[12,14],[15,16],[20,21],[28,29],[33,34],[46,47],[52,53],[59,60],[61,62]],"en":"And We placed therein lofty, firmly set mountains and have given you to drink sweet water."},{"n":28,"ar":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","tg":[[4,9,12],[15,21,13],[30,33,4]],"tr":"Waylun yawmaithin lilmukaththibeena","tu":[[13,15],[25,29],[31,33]],"en":"Woe, that Day, to the deniers."},{"n":29,"ar":"ٱنطَلِقُوٓا۟ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ","tg":[[1,4,9],[6,10,6],[10,12,1],[26,29,9],[33,36,3],[44,47,4]],"tr":"Intaliqoo ila ma kuntum bihi tukaththiboona","tu":[[2,3],[12,13],[15,16],[33,37],[39,41]],"en":"[They will be told], \"Proceed to that which you used to deny."},{"n":30,"ar":"ٱنطَلِقُوٓا۟ إِلَىٰ ظِلٍّ ذِى ثَلَـٰثِ شُعَبٍ","tg":[[1,4,9],[6,10,6],[10,12,1],[22,28,9],[32,36,3],[43,45,7]],"tr":"Intaliqoo ila thillin thee thalathi shuAAabin","tu":[[2,3],[12,13],[14,16],[22,26],[31,32]],"en":"Proceed to a shadow [of smoke] having three columns."},{"n":31,"ar":"لَّا ظَلِيلٍ وَلَا يُغْنِى مِنَ ٱللَّهَبِ","tg":[[10,15,12],[32,33,0],[33,34,2],[39,41,7]],"tr":"La thaleelin wala yughnee mina allahabi","tu":[[1,2],[3,5],[7,9],[16,17],[23,25],[34,35]],"ts":[[31,32]],"en":"[But having] no cool shade and availing not against the flame.\""},{"n":32,"ar":"إِنَّهَا تَرْمِى بِشَرَرٍ كَٱلْقَصْرِ","tg":[[2,5,14],[23,28,9],[28,29,0]],"tr":"Innaha tarmee bishararin kaalqasri","tu":[[5,6],[11,13],[31,32]],"ts":[[27,28]],"en":"Indeed, it throws sparks [as huge] as a fortress,"},{"n":33,"ar":"كَأَنَّهُۥ جِمَـٰلَتٌ صُفْرٌ","tg":[[4,7,14],[7,10,3],[13,17,3],[19,24,9]],"tr":"Kaannahu jimalatun sufrun","tu":[[12,13],[19,20]],"en":"As if they were yellowish [black] camels."},{"n":34,"ar":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","tg":[[4,9,12],[15,21,13],[30,33,4]],"tr":"Waylun yawmaithin lilmukaththibeena","tu":[[13,15],[25,29],[31,33]],"en":"Woe, that Day, to the deniers."},{"n":35,"ar":"هَـٰذَا يَوْمُ لَا يَنطِقُونَ","tg":[[0,4,3],[21,24,9],[24,27,4]],"tr":"Hatha yawmu la yantiqoona","tu":[[1,5],[13,14],[18,19],[21,23]],"en":"This is a Day they will not speak,"},{"n":36,"ar":"وَلَا يُؤْذَنُ لَهُمْ فَيَعْتَذِرُونَ","tg":[[32,35,4]],"tr":"Wala yuthanu lahum fayaAAtathiroona","tu":[[3,4],[7,9],[27,29],[31,33]],"en":"Nor will it be permitted for them to make an excuse."},{"n":37,"ar":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","tg":[[4,9,12],[15,21,13],[30,33,4]],"tr":"Waylun yawmaithin lilmukaththibeena","tu":[[13,15],[25,29],[31,33]],"en":"Woe, that Day, to the deniers."},{"n":38,"ar":"هَـٰذَا يَوْمُ ٱلْفَصْلِ ۖ جَمَعْنَـٰكُمْ وَٱلْأَوَّلِينَ","tg":[[0,4,3],[15,16,0],[33,37,3],[44,45,0],[52,55,4]],"tr":"Hatha yawmu alfasli jamaAAnakum waalawwaleena","tu":[[1,5],[16,17],[27,28],[41,43]],"ts":[[12,13],[34,35]],"en":"This is the Day of Judgement; We will have assembled you and the former peoples."},{"n":39,"ar":"فَإِن كَانَ لَكُمْ كَيْدٌ فَكِيدُونِ","tg":[[4,8,9],