[{"n":1,"ar":" قُلْ أَعُوذُ بِرَبِّ ٱلْفَلَقِ","tg":[[22,23,0],[29,31,7]],"tr":"Qul aAAoothu birabbi alfalaqi","tu":[[9,11]],"ts":[[21,22]],"en":"Say, \"I seek refuge in the Lord of daybreak"},{"n":2,"ar":"مِن شَرِّ مَا خَلَقَ","tg":[[2,6,9],[18,20,7]],"tr":"Min sharri ma khalaqa","tu":[[12,13]],"en":"From the evil of that which He created"},{"n":3,"ar":"وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ","tg":[[4,8,9],[30,32,7]],"tr":"Wamin sharri ghasiqin itha waqaba","tu":[[15,16],[23,26]],"en":"And from the evil of darkness when it settles"},{"n":4,"ar":"وَمِن شَرِّ ٱلنَّفَّـٰثَـٰتِ فِى ٱلْعُقَدِ","tg":[[4,8,9],[12,13,0],[13,14,2],[14,17,14],[17,22,3],[22,26,3],[33,34,0],[40,42,7]],"tr":"Wamin sharri alnnaffathati fee alAAuqadi","tu":[[20,21],[23,24]],"ts":[[13,14],[14,15],[31,32]],"en":"And from the evil of the blowers in knots"},{"n":5,"ar":"وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ","tg":[[4,8,9],[30,32,7]],"tr":"Wamin sharri hasidin itha hasada","tu":[[13,15],[22,25],[26,27]],"en":"And from the evil of an envier when he envies.\""}]