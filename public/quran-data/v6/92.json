[{"n":1,"ar":" وَٱلَّيْلِ إِذَا يَغْشَىٰ","tg":[[3,4,0]],"tr":"Waallayli itha yaghsha","tu":[[11,14],[21,22]],"ts":[[2,3]],"en":"By the night when it covers"},{"n":2,"ar":"وَٱلنَّهَارِ إِذَا تَجَلَّىٰ","tg":[[2,3,0],[3,4,2],[4,7,14]],"tr":"Waalnnahari itha tajalla","tu":[[8,9],[13,16],[23,24]],"ts":[[2,3],[3,4]],"en":"And [by] the day when it appears"},{"n":3,"ar":"وَمَا خَلَقَ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ","tg":[[13,14,0],[14,15,2],[25,26,0],[30,33,9]],"tr":"Wama khalaqa alththakara waalontha","tu":[[3,4],[15,19],[33,34]],"ts":[[13,14],[14,15],[27,28]],"en":"And [by] He who created the male and female,"},{"n":4,"ar":"إِنَّ سَعْيَكُمْ لَشَتَّىٰ","tg":[[2,5,14]],"tr":"Inna saAAyakum lashatta","tu":[[22,23]],"en":"Indeed, your efforts are diverse."},{"n":5,"ar":"فَأَمَّا مَنْ أَعْطَىٰ وَٱتَّقَىٰ","tg":[[4,7,14],[25,26,0]],"tr":"Faamma man aAAta waittaqa","tu":[[5,6],[14,16],[24,25]],"ts":[[19,20]],"en":"As for he who gives and fears Allāh"},{"n":6,"ar":"وَصَدَّقَ بِٱلْحُسْنَىٰ","tg":[[12,13,0]],"tr":"Wasaddaqa bialhusna","tu":[[2,3],[14,15],[18,19]],"ts":[[12,13]],"en":"And believes in the best [reward],"},{"n":7,"ar":"فَسَنُيَسِّرُهُۥ لِلْيُسْرَىٰ","tg":[[13,16,3]],"tr":"Fasanuyassiruhu lilyusra","tu":[[23,24]],"en":"We will ease him toward ease."},{"n":8,"ar":"وَأَمَّا مَنۢ بَخِلَ وَٱسْتَغْنَىٰ","tg":[[4,7,14],[9,16,11],[23,24,0]],"tr":"Waamma man bakhila waistaghna","tu":[[5,6],[28,29]],"ts":[[21,22]],"en":"But as for he who withholds and considers himself free of need"},{"n":9,"ar":"وَكَذَّبَ بِٱلْحُسْنَىٰ","tg":[[12,13,0]],"tr":"Wakaththaba bialhusna","tu":[[4,8],[16,17],[20,21]],"ts":[[14,15]],"en":"And denies the best [reward],"},{"n":10,"ar":"فَسَنُيَسِّرُهُۥ لِلْعُسْرَىٰ","tg":[[13,16,3]],"tr":"Fasanuyassiruhu lilAAusra","tu":[[24,25]],"en":"We will ease him toward difficulty."},{"n":11,"ar":"وَمَا يُغْنِى عَنْهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ","tg":[[26,30,6]],"tr":"Wama yughnee AAanhu maluhu itha taradda","tu":[[3,4],[21,22],[28,31],[38,39]],"en":"And what will his wealth avail him when he falls?"},{"n":12,"ar":"إِنَّ عَلَيْنَا لَلْهُدَىٰ","tg":[[2,5,14]],"tr":"Inna AAalayna lalhuda","tu":[[12,13],[20,21]],"en":"Indeed, [incumbent] upon Us is guidance."},{"n":13,"ar":"وَإِنَّ لَنَا لَلْـَٔاخِرَةَ وَٱلْأُولَىٰ","tg":[[4,7,14],[31,32,0]],"tr":"Wainna lana lalakhirata waaloola","tu":[[10,11],[15,16],[31,32]],"ts":[[26,27]],"en":"And indeed, to us belongs the Hereafter and the first [life]."},{"n":14,"ar":"فَأَنذَرْتُكُمْ نَارًا تَلَظَّىٰ","tg":[[4,7,9],[19,25,9]],"tr":"Faanthartukum naran talaththa","tu":[[4,6],[15,16],[24,29]],"en":"So I have warned you of a Fire which is blazing."},{"n":15,"ar":"لَا يَصْلَىٰهَآ إِلَّا ٱلْأَشْقَى","tr":"La yaslaha illa alashqa","tu":[[1,2],[5,6],[7,8],[9,10],[14,15],[22,23]],"ts":[[16,17]],"en":"None will [enter to] burn therein except the most wretched one"},{"n":16,"ar":"ٱلَّذِى كَذَّبَ وَتَوَلَّىٰ","tr":"Allathee kaththaba watawalla","tu":[[4,6],[11,15],[27,28]],"en":"Who had denied and turned away."},{"n":17,"ar":"وَسَيُجَنَّبُهَا ٱلْأَتْقَى","tg":[[8,11,14],[17,18,0]],"tr":"Wasayujannabuha alatqa","tu":[[14,15],[21,22]],"ts":[[16,17]],"en":"But the righteous one will avoid it"},{"n":18,"ar":"ٱلَّذِى يُؤْتِى مَالَهُۥ يَتَزَكَّىٰ","tg":[[21,24,3]],"tr":"Allathee yutee malahu yatazakka","tu":[[4,6],[16,17],[30,31]],"en":"[He] who gives [from] his wealth to purify himself"},{"n":19,"ar":"وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعْمَةٍ تُجْزَىٰٓ","tg":[[17,20,9],[20,23,3],[24,31,12],[35,40,9],[40,42,7]],"tr":"Wama liahadin AAindahu min niAAmatin tujza","tu":[[3,4],[8,9],[41,42]],"en":"And not [giving] for anyone who has [done him] a favor to be rewarded"},{"n":20,"ar":"إِلَّا ٱبْتِغَآءَ وَجْهِ رَبِّهِ ٱلْأَعْلَىٰ","tg":[[7,8,0],[8,10,7],[12,16,6],[21,23,7],[34,35,0]],"tr":"Illa ibtighaa wajhi rabbihi alaAAla","tu":[[3,4],[11,12],[34,35]],"ts":[[5,6],[28,29]],"en":"But only seeking the face [i.e., acceptance] of his Lord, Most High."},{"n":21,"ar":"وَلَسَوْفَ يَرْضَىٰ","tr":"Walasawfa yarda","tu":[[13,15]],"en":"And he is going to be satisfied."}]