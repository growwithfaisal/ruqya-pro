[{"n":1,"ar":" قُلْ أَعُوذُ بِرَبِّ ٱلنَّاسِ","tr":"Qul aAAoothu birabbi annas","en":"Say, \"I seek refuge in the Lord of mankind,"},{"n":2,"ar":"مَلِكِ ٱلنَّاسِ","tr":"Maliki annas","en":"The Sovereign of mankind,"},{"n":3,"ar":"إِلَـٰهِ ٱلنَّاسِ","tr":"Ilahi annas","en":"The God of mankind,"},{"n":4,"ar":"مِن شَرِّ ٱلْوَسْوَاسِ ٱلْخَنَّاسِ","tr":"Min sharri alwaswasi alkhannas","en":"From the evil of the retreating whisperer -"},{"n":5,"ar":"ٱلَّذِى يُوَسْوِسُ فِى صُدُورِ ٱلنَّاسِ","tr":"Allathee yuwaswisu fee sudoori annas","en":"Who whispers [evil] into the breasts of mankind -"},{"n":6,"ar":"مِنَ ٱلْجِنَّةِ وَٱلنَّاسِ","tr":"Mina aljinnati wannas","en":"From among the jinn and mankind\"."}]