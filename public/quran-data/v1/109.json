[{"n":1,"ar":" قُلْ يَـٰٓأَيُّهَا ٱلْكَـٰفِرُونَ","tr":"Qul ya ayyuha alkafiroon","en":"Say, \"O disbelievers,"},{"n":2,"ar":"لَآ أَعْبُدُ مَا تَعْبُدُونَ","tr":"La aAAbudu ma taAAbudoon","en":"I do not worship what you worship."},{"n":3,"ar":"وَلَآ أَنتُمْ عَـٰبِدُونَ مَآ أَعْبُدُ","tr":"Wala antum AAabidoona maaAAbud","en":"Nor are you worshippers of what I worship."},{"n":4,"ar":"وَلَآ أَنَا۠ عَابِدٌ مَّا عَبَدتُّمْ","tr":"Wala ana AAabidun maAAabadtum","en":"Nor will I be a worshipper of what you worship."},{"n":5,"ar":"وَلَآ أَنتُمْ عَـٰبِدُونَ مَآ أَعْبُدُ","tr":"Wala antum AAabidoona maaAAbud","en":"Nor will you be worshippers of what I worship."},{"n":6,"ar":"لَكُمْ دِينُكُمْ وَلِىَ دِينِ","tr":"Lakum deenukum waliya deen","en":"For you is your religion, and for me is my religion.\""}]