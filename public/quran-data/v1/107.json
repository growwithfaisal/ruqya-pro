[{"n":1,"ar":" أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ","tr":"Araayta allathee yukaththibu biddeen","en":"Have you seen the one who denies the Recompense?"},{"n":2,"ar":"فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ","tr":"Fathalika allathee yaduAAAAualyateem","en":"For that is the one who drives away the orphan"},{"n":3,"ar":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ","tr":"Wala yahuddu AAalataAAami almiskeen","en":"And does not encourage the feeding of the poor."},{"n":4,"ar":"فَوَيْلٌ لِّلْمُصَلِّينَ","tr":"Fawaylun lilmusalleen","en":"So woe to those who pray"},{"n":5,"ar":"ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ","tr":"Allatheena hum AAan salatihimsahoon","en":"[But] who are heedless of their prayer -"},{"n":6,"ar":"ٱلَّذِينَ هُمْ يُرَآءُونَ","tr":"Allatheena hum yuraoon","en":"Those who make show [of their deeds]"},{"n":7,"ar":"وَيَمْنَعُونَ ٱلْمَاعُونَ","tr":"WayamnaAAoona almaAAoon","en":"And withhold [simple] assistance."}]