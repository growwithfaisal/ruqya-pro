[{"n":1,"ar":" ٱلْقَارِعَةُ","tr":"AlqariAAa","en":"The Striking Calamity -"},{"n":2,"ar":"مَا ٱلْقَارِعَةُ","tr":"Ma alqariAAa","en":"What is the Striking Calamity?"},{"n":3,"ar":"وَمَآ أَدْرَىٰكَ مَا ٱلْقَارِعَةُ","tr":"Wama adraka ma alqariAAa","en":"And what can make you know what is the Striking Calamity?"},{"n":4,"ar":"يَوْمَ يَكُونُ ٱلنَّاسُ كَٱلْفَرَاشِ ٱلْمَبْثُوثِ","tr":"Yawma yakoonu annasu kalfarashialmabthooth","en":"It is the Day when people will be like moths, dispersed,"},{"n":5,"ar":"وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ٱلْمَنفُوشِ","tr":"Watakoonu aljibalu kalAAihnialmanfoosh","en":"And the mountains will be like wool, fluffed up."},{"n":6,"ar":"فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ","tr":"Faamma man thaqulat mawazeenuh","en":"Then as for one whose scales are heavy [with good deeds],"},{"n":7,"ar":"فَهُوَ فِى عِيشَةٍ رَّاضِيَةٍ","tr":"Fahuwa fee AAeeshatin radiya","en":"He will be in a pleasant life."},{"n":8,"ar":"وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ","tr":"Waamma man khaffat mawazeenuh","en":"But as for one whose scales are light,"},{"n":9,"ar":"فَأُمُّهُۥ هَاوِيَةٌ","tr":"Faommuhu hawiya","en":"His refuge will be an abyss."},{"n":10,"ar":"وَمَآ أَدْرَىٰكَ مَا هِيَهْ","tr":"Wama adraka ma hiya","en":"And what can make you know what that is?"},{"n":11,"ar":"نَارٌ حَامِيَةٌۢ","tr":"Narun hamiya","en":"It is a Fire, intensely hot."}]