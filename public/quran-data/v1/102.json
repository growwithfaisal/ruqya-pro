[{"n":1,"ar":" أَلْهَىٰكُمُ ٱلتَّكَاثُرُ","tr":"Alhakumu attakathur","en":"Competition in [worldly] increase diverts you"},{"n":2,"ar":"حَتَّىٰ زُرْتُمُ ٱلْمَقَابِرَ","tr":"Hatta zurtumu almaqabir","en":"Until you visit the graveyards."},{"n":3,"ar":"كَلَّا سَوْفَ تَعْلَمُونَ","tr":"Kalla sawfa taAAlamoon","en":"No! You are going to know."},{"n":4,"ar":"ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَ","tr":"Thumma kalla sawfa taAAlamoon","en":"Then, no! You are going to know."},{"n":5,"ar":"كَلَّا لَوْ تَعْلَمُونَ عِلْمَ ٱلْيَقِينِ","tr":"Kalla law taAAlamoona AAilma alyaqeen","en":"No! If you only knew with knowledge of certainty..."},{"n":6,"ar":"لَتَرَوُنَّ ٱلْجَحِيمَ","tr":"Latarawunna aljaheem","en":"You will surely see the Hellfire."},{"n":7,"ar":"ثُمَّ لَتَرَوُنَّهَا عَيْنَ ٱلْيَقِينِ","tr":"Thumma latarawunnaha AAayna alyaqeen","en":"Then you will surely see it with the eye of certainty."},{"n":8,"ar":"ثُمَّ لَتُسْـَٔلُنَّ يَوْمَئِذٍ عَنِ ٱلنَّعِيمِ","tr":"Thumma latus-alunna yawma-ithin AAaniannaAAeem","en":"Then you will surely be asked that Day about pleasure."}]