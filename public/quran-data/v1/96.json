[{"n":1,"ar":" ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ","tr":"Iqra/ bi-ismi rabbika allathee khalaq","en":"Recite in the name of your Lord who created"},{"n":2,"ar":"خَلَقَ ٱلْإِنسَـٰنَ مِنْ عَلَقٍ","tr":"Khalaqa al-insana min AAalaq","en":"Created man from a clinging substance."},{"n":3,"ar":"ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ","tr":"Iqra/ warabbuka al-akram","en":"Recite, and your Lord is the most Generous -"},{"n":4,"ar":"ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ","tr":"Allathee AAallama bilqalam","en":"Who taught by the pen"},{"n":5,"ar":"عَلَّمَ ٱلْإِنسَـٰنَ مَا لَمْ يَعْلَمْ","tr":"AAallama al-insana ma lamyaAAlam","en":"Taught man that which he knew not."},{"n":6,"ar":"كَلَّآ إِنَّ ٱلْإِنسَـٰنَ لَيَطْغَىٰٓ","tr":"Kalla inna al-insana layatgha","en":"No! [But] indeed, man transgresses"},{"n":7,"ar":"أَن رَّءَاهُ ٱسْتَغْنَىٰٓ","tr":"An raahu istaghna","en":"Because he sees himself self-sufficient."},{"n":8,"ar":"إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجْعَىٰٓ","tr":"Inna ila rabbika arrujAAa","en":"Indeed, to your Lord is the return."},{"n":9,"ar":"أَرَءَيْتَ ٱلَّذِى يَنْهَىٰ","tr":"Araayta allathee yanha","en":"Have you seen the one who forbids"},{"n":10,"ar":"عَبْدًا إِذَا صَلَّىٰٓ","tr":"AAabdan itha salla","en":"A servant when he prays?"},{"n":11,"ar":"أَرَءَيْتَ إِن كَانَ عَلَى ٱلْهُدَىٰٓ","tr":"Araayta in kana AAala alhuda","en":"Have you seen if he is upon guidance"},{"n":12,"ar":"أَوْ أَمَرَ بِٱلتَّقْوَىٰٓ","tr":"Aw amara bittaqwa","en":"Or enjoins righteousness?"},{"n":13,"ar":"أَرَءَيْتَ إِن كَذَّبَ وَتَوَلَّىٰٓ","tr":"Araayta in kaththaba watawalla","en":"Have you seen if he denies and turns away -"},{"n":14,"ar":"أَلَمْ يَعْلَم بِأَنَّ ٱللَّهَ يَرَىٰ","tr":"Alam yaAAlam bi-anna Allaha yara","en":"Does he not know that Allāh sees?"},{"n":15,"ar":"كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًۢا بِٱلنَّاصِيَةِ","tr":"Kalla la-in lam yantahi lanasfaAAanbinnasiya","en":"No! If he does not desist, We will surely drag him by the forelock"},{"n":16,"ar":"نَاصِيَةٍ كَـٰذِبَةٍ خَاطِئَةٍ","tr":"Nasiyatin kathibatin khati-a","en":"A lying, sinning forelock."},{"n":17,"ar":"فَلْيَدْعُ نَادِيَهُۥ","tr":"FalyadAAu nadiyah","en":"Then let him call his associates;"},{"n":18,"ar":"سَنَدْعُ ٱلزَّبَانِيَةَ","tr":"SanadAAu azzabaniya","en":"We will call the angels of Hell."},{"n":19,"ar":"كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب ۩","tr":"Kalla la tutiAAhu wasjudwaqtarib","en":"No! Do not obey him. But prostrate and draw near [to Allāh]."}]