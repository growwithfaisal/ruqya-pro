[{"n":1,"ar":" قُلْ هُوَ ٱللَّهُ أَحَدٌ","tr":"Qul huwa Allahu ahad","en":"Say, \"He is Allāh, [who is] One,"},{"n":2,"ar":"ٱللَّهُ ٱلصَّمَدُ","tr":"Allahu assamad","en":"Allāh, the Eternal Refuge."},{"n":3,"ar":"لَمْ يَلِدْ وَلَمْ يُولَدْ","tr":"Lam yalid walam yoolad","en":"He neither begets nor is born,"},{"n":4,"ar":"وَلَمْ يَكُن لَّهُۥ كُفُوًا أَحَدٌۢ","tr":"Walam yakun lahu kufuwan ahad","en":"Nor is there to Him any equivalent.\""}]